---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Nueva solicitud">
  <main class="contenedor">
    <div class="tarjeta" style="max-width:640px; margin:0 auto">
      <h1>Nueva solicitud de soporte</h1>
      <p class="subtitulo">Describe tu problema y adjunta un archivo si lo deseas.</p>
      <div id="mensaje" class="mensaje" style="display:none"></div>
      <form id="form-solicitud">
        <div class="campo">
          <label for="asunto">Asunto</label>
          <input type="text" id="asunto" name="asunto" required maxlength="200"
            placeholder="Ej: PC no inicia" />
        </div>
        <div class="campo">
          <label for="descripcion">Descripción</label>
          <textarea id="descripcion" name="descripcion" rows="4" required
            placeholder="Describe el problema con detalle"></textarea>
        </div>
        <div class="campo">
          <label for="prioridad">Prioridad</label>
          <select id="prioridad" name="prioridad" required>
            <option value="Baja">Baja</option>
            <option value="Media" selected>Media</option>
            <option value="Alta">Alta</option>
            <option value="Critica">Crítica</option>
          </select>
        </div>
        <div class="campo">
          <label for="archivo">Archivo adjunto (opcional)</label>
          <input type="file" id="archivo" name="archivo" accept=".png,.jpg,.jpeg,.gif,.webp,.bmp,.pdf,.mp4,.webm,.avi,.mov,.mp3,.wav,.txt,.csv,.zip,.rar,.7z,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.rtf" />
          <span class="texto-suave" id="nombre-archivo" style="display:none; font-size:.85rem"></span>
        </div>
        <p class="texto-suave" style="font-size:.8rem; margin-top:-.4rem">
          Formatos permitidos: imágenes (PNG, JPG, GIF, WEBP), video (MP4, WEBM), PDF, texto (TXT, CSV), comprimidos (ZIP, RAR, 7Z) y documentos de oficina (DOC, XLS, PPT y sus variantes). Tamaño máximo 5 MB.
        </p>
        <button class="boton" type="submit">Enviar solicitud</button>
      </form>
    </div>
  </main>

  <script>
    import { obtenerUsuario, peticion } from "../scripts/api.js";

    // Protege la página: sin sesión se va al login
    if (!obtenerUsuario()) window.location.href = "/login";

    const form = document.getElementById("form-solicitud") as HTMLFormElement;
    const mensaje = document.getElementById("mensaje") as HTMLDivElement;
    const inputArchivo = document.getElementById("archivo") as HTMLInputElement;
    const nombreArchivo = document.getElementById("nombre-archivo") as HTMLSpanElement;

    inputArchivo.addEventListener("change", () => {
      if (inputArchivo.files && inputArchivo.files.length > 0) {
        nombreArchivo.textContent = "Archivo elegido: " + inputArchivo.files[0].name;
        nombreArchivo.style.display = "inline";
      } else {
        nombreArchivo.style.display = "none";
      }
    });

    function mostrarMensaje(texto: string, tipo: string) {
      mensaje.textContent = texto;
      mensaje.className = `mensaje ${tipo}`;
      mensaje.style.display = "block";
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      // Se envía multipart/form-data (incluye el archivo)
      const datos = new FormData(form);
      try {
        const respuesta = await peticion("/api/solicitudes", {
          method: "POST",
          body: datos,
        });
        const json = await respuesta.json();
        if (!json.success) {
          mostrarMensaje(json.message || "Error al crear la solicitud", "mensaje-error");
          return;
        }
        mostrarMensaje(`Su solicitud #${json.data.id} ha sido registrada correctamente.`, "mensaje-ok");
        form.reset();
        setTimeout(() => (window.location.href = "/mis-solicitudes"), 1500);
      } catch {
        mostrarMensaje("No se pudo conectar con el servidor", "mensaje-error");
      }
    });
  </script>
</Layout>
