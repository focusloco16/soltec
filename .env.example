# Variables de entorno - Sistema de Solicitudes de Soporte Técnico
# Copia este archivo a ".env" y completa los valores reales.
# No subas el ".env" real al repositorio.

# --- Base de datos MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adso_cimm

# --- Autenticación JWT ---
# Genera un secreto largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=adso_cimm_cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# --- Correo SMTP (Gmail) ---
# Gmail requiere una "Contraseña de aplicación" (no la contraseña normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=edwinpan714@gmail.com
# SMTP_PASS debe ser la contraseña de aplicación de 16 caracteres.
SMTP_PASS=
SMTP_FROM="Soporte Técnico <edwinpan714@gmail.com>"

# --- Almacenamiento de archivos ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
